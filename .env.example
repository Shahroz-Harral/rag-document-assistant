# LLM Providers (get free API keys — no credit card needed)
GOOGLE_API_KEY=your_gemini_key_here          # https://aistudio.google.com
GROQ_API_KEY=your_groq_key_here              # https://console.groq.com (optional fallback)

# Vector Database
PINECONE_API_KEY=your_pinecone_key_here      # https://www.pinecone.io
PINECONE_INDEX_NAME=rag-documents

# Observability (optional)
LANGSMITH_API_KEY=your_langsmith_key_here     # https://smith.langchain.com
LANGSMITH_PROJECT=rag-document-assistant
LANGCHAIN_TRACING_V2=true

# App Settings
APP_ENV=development
LOG_LEVEL=info
LLM_PROVIDER=gemini                          # Options: gemini, groq
